<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="Consul" Version="1.8.0" />
        <PackageVersion Include="CSRedisCore" Version="3.8.807" />
        <PackageVersion Include="Mapster" Version="10.0.13" />
        <PackageVersion Include="Mapster.DependencyInjection" Version="10.0.13" />
        <PackageVersion Include="MiniExcel" Version="1.45.0" />
        <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageVersion Include="SqlSugarCore" Version="5.1.4.221" />
        <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
        <PackageVersion Include="UAParser" Version="3.1.47" />
        <PackageVersion Include="Yitter.IdGenerator" Version="1.0.14" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.32" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.32" />
        <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.21" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="9.0.21" />
        <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.13" />
        <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    </ItemGroup>

</Project>
