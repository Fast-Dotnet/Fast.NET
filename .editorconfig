# Fast .NET 推荐配置
# 适用于现代 C# 项目；文件范围命名空间需要 C# 10 或更高版本。
# 仅统一编辑与代码风格，不设置目标框架、语言版本、Nullable 或构建告警策略。

root = true

# 通用文本规则
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C# 与 Razor
[*.{cs,csx,razor,cshtml}]
indent_style = space
indent_size = 4
tab_width = 4

# MSBuild、资源与 XML
[*.{csproj,fsproj,vbproj,props,targets,nuspec,resx,xml,config,xaml,axaml}]
indent_style = space
indent_size = 4
tab_width = 4

# JSON 与 YAML
[*.{json,jsonc,yml,yaml}]
indent_style = space
indent_size = 2
tab_width = 2

# Markdown 行末双空格可用于显式换行。
[*.md]
trim_trailing_whitespace = false

# Windows 批处理使用 CRLF。
[*.{bat,cmd}]
end_of_line = crlf

[*.cs]

# 自有源码文件头；第三方源码保留原有版权与许可声明。
# 模板正文不包含 //，使用 \n 表示换行；IDE0073 提供检查与修复。
file_header_template = Copyright © 2018-Present 小方\nSPDX-License-Identifier: Apache-2.0\n\n本文件依据 Apache License 2.0 授权，完整条款见仓库根目录 LICENSE。\n本软件按“原样”提供，相关免责声明及责任限制以许可证及适用法律为准。\n版权来源、合法使用与二次开发责任说明见仓库根目录 README.md。
dotnet_diagnostic.IDE0073.severity = suggestion

# using 与命名空间
# System 命名空间优先，using 分组之间不添加空行。
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion

# 修饰符与成员访问
# 非接口成员显式声明可见性，不添加多余的 this. 限定。
csharp_preferred_modifier_order = public, private, protected, internal, file, static, extern, new, virtual, abstract, sealed, override, readonly, unsafe, required, volatile, async:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
dotnet_style_readonly_field = true:suggestion

# 类型表达
# 使用 C# 关键字类型；右侧类型明显时使用 var，其余场景优先显式类型。
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# 大括号与换行
# 使用 Allman 布局，控制语句保留大括号。
csharp_prefer_braces = true:suggestion
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# 缩进
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current

# 空格
csharp_space_around_binary_operators = before_and_after
csharp_space_after_cast = false
csharp_space_after_comma = true
csharp_space_before_comma = false
csharp_space_after_dot = false
csharp_space_before_dot = false
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_after_semicolon_in_for_statement = true
csharp_space_before_semicolon_in_for_statement = false
csharp_space_before_open_square_brackets = false
csharp_space_between_square_brackets = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false

# 单行成员
# 保留简洁的单行块与自动属性，不将多条普通语句合并到同一行。
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = false
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_expression_bodied_accessors = when_on_single_line:suggestion

# 风格提示
# 仅设置风格诊断，不覆盖正确性、安全性或可空性诊断。
dotnet_diagnostic.IDE0005.severity = suggestion
dotnet_diagnostic.IDE0055.severity = suggestion
dotnet_diagnostic.IDE1006.severity = suggestion

# 命名风格
# 类型、常规成员和常量采用 PascalCase；接口采用 I 前缀。
# 私有/内部实例字段采用 _camelCase，私有/内部静态字段采用 s_camelCase。
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.interface_case.capitalization = pascal_case
dotnet_naming_style.interface_case.required_prefix = I
dotnet_naming_style.instance_field_case.capitalization = camel_case
dotnet_naming_style.instance_field_case.required_prefix = _
dotnet_naming_style.static_field_case.capitalization = camel_case
dotnet_naming_style.static_field_case.required_prefix = s_

# 类型与命名空间；class、struct 分别包含对应的 record 类型。
dotnet_naming_symbols.types.applicable_kinds = namespace, class, struct, enum, delegate
dotnet_naming_symbols.types.applicable_accessibilities = *
dotnet_naming_rule.types_pascal.symbols = types
dotnet_naming_rule.types_pascal.style = pascal_case
dotnet_naming_rule.types_pascal.severity = suggestion

# 接口
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_rule.interfaces_prefixed.symbols = interfaces
dotnet_naming_rule.interfaces_prefixed.style = interface_case
dotnet_naming_rule.interfaces_prefixed.severity = suggestion

# 属性、方法、事件与局部函数
dotnet_naming_symbols.members.applicable_kinds = property, method, event, local_function
dotnet_naming_symbols.members.applicable_accessibilities = *
dotnet_naming_rule.members_pascal.symbols = members
dotnet_naming_rule.members_pascal.style = pascal_case
dotnet_naming_rule.members_pascal.severity = suggestion

# 公开及受保护字段不添加 m 或下划线前缀。
dotnet_naming_symbols.visible_fields.applicable_kinds = field
dotnet_naming_symbols.visible_fields.applicable_accessibilities = public, protected, protected_internal, private_protected
dotnet_naming_rule.visible_fields_pascal.symbols = visible_fields
dotnet_naming_rule.visible_fields_pascal.style = pascal_case
dotnet_naming_rule.visible_fields_pascal.severity = suggestion

# 私有/内部字段；静态字段由下方更具体的规则处理。
dotnet_naming_symbols.implementation_fields.applicable_kinds = field
dotnet_naming_symbols.implementation_fields.applicable_accessibilities = private, internal
dotnet_naming_rule.implementation_fields_underscore.symbols = implementation_fields
dotnet_naming_rule.implementation_fields_underscore.style = instance_field_case
dotnet_naming_rule.implementation_fields_underscore.severity = suggestion

dotnet_naming_symbols.implementation_static_fields.applicable_kinds = field
dotnet_naming_symbols.implementation_static_fields.applicable_accessibilities = private, internal
dotnet_naming_symbols.implementation_static_fields.required_modifiers = static
dotnet_naming_rule.implementation_static_fields_prefixed.symbols = implementation_static_fields
dotnet_naming_rule.implementation_static_fields_prefixed.style = static_field_case
dotnet_naming_rule.implementation_static_fields_prefixed.severity = suggestion

# 字段常量与局部常量
dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal_case
dotnet_naming_rule.constants_pascal.severity = suggestion

# const 隐含 static，交集规则确保私有/内部常量仍采用 PascalCase。
dotnet_naming_symbols.implementation_constants.applicable_kinds = field
dotnet_naming_symbols.implementation_constants.applicable_accessibilities = private, internal
dotnet_naming_symbols.implementation_constants.required_modifiers = const
dotnet_naming_rule.implementation_constants_pascal.symbols = implementation_constants
dotnet_naming_rule.implementation_constants_pascal.style = pascal_case
dotnet_naming_rule.implementation_constants_pascal.severity = suggestion

# 普通参数与局部变量采用 camelCase；record 位置参数采用 PascalCase。
# 不以统一 parameter 规则覆盖这两类不同语义的命名。

# ReSharper / Rider 格式补充
# 行宽是折行目标，配合工具的 Wrap long lines 设置使用。
resharper_csharp_max_line_length = 130

# 按配置重新安排换行，不锁定已有语句、表达式体和初始化器的布局。
resharper_csharp_keep_existing_linebreaks = false
resharper_csharp_keep_existing_embedded_arrangement = false
resharper_csharp_keep_existing_expr_member_arrangement = false
resharper_csharp_keep_existing_initializer_arrangement = false

# 短链式调用保持紧凑；超长或多行调用按步骤展开；不优先在首个方法调用前换行。
resharper_csharp_wrap_chained_method_calls = chop_if_long
resharper_csharp_wrap_before_first_method_call = false
resharper_csharp_wrap_after_dot_in_method_calls = false
resharper_csharp_wrap_after_property_in_chained_method_calls = false
resharper_csharp_wrap_linq_expressions = chop_always

# 参数列表按长度换行，不要求所有参数逐项独占一行。
resharper_csharp_wrap_parameters_style = wrap_if_long
resharper_csharp_wrap_arguments_style = wrap_if_long
resharper_csharp_wrap_before_binary_opsign = true
resharper_csharp_wrap_chained_binary_expressions = chop_if_long
resharper_csharp_wrap_before_binary_pattern_op = true
resharper_csharp_wrap_chained_binary_patterns = chop_if_long
resharper_csharp_nested_ternary_style = compact

# 类型及成员特性独立成行。
resharper_csharp_place_type_attribute_on_same_line = false
resharper_csharp_place_method_attribute_on_same_line = false
resharper_csharp_place_accessorholder_attribute_on_same_line = false
resharper_csharp_place_field_attribute_on_same_line = false

# 自动属性保持单行；带实现的块体成员和控制语句分行。
resharper_csharp_place_abstract_accessorholder_on_single_line = true
resharper_csharp_place_simple_accessorholder_on_single_line = false
resharper_csharp_place_simple_accessor_on_single_line = false
resharper_csharp_place_simple_method_on_single_line = false
resharper_csharp_place_simple_embedded_statement_on_same_line = false
resharper_csharp_place_simple_embedded_block_on_same_line = false

# 注释跟随代码缩进，单行初始化表达式的大括号内侧不额外加空格。
resharper_csharp_stick_comment = false
resharper_csharp_space_within_single_line_array_initializer_braces = false

# ReSharper / Rider 风格提示
resharper_inconsistent_naming_highlighting = hint
resharper_arrange_this_qualifier_highlighting = hint
resharper_arrange_type_member_modifiers_highlighting = hint
resharper_arrange_type_modifiers_highlighting = hint
resharper_built_in_type_reference_style_for_member_access_highlighting = hint
resharper_built_in_type_reference_style_highlighting = hint
resharper_suggest_var_or_type_built_in_types_highlighting = hint
resharper_suggest_var_or_type_elsewhere_highlighting = hint
resharper_suggest_var_or_type_simple_types_highlighting = hint
resharper_redundant_base_qualifier_highlighting = hint

# 生成代码不要求文件头，ReSharper Code Cleanup 跳过这些文件。
[*.{g,g.i,generated,designer,Designer}.cs]
generated_code = true
file_header_template = unset
dotnet_diagnostic.IDE0073.severity = none
resharper_substitution_for_cleanup_profile = * => skip

[**/{bin,obj}/**]
generated_code = true
file_header_template = unset
dotnet_diagnostic.IDE0073.severity = none
resharper_substitution_for_cleanup_profile = * => skip
