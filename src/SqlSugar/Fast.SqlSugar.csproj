<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Version>4.0.0</Version>
		<PackageId>Fast.SqlSugar</PackageId>
		<Description>Fast.NET 框架 SqlSugar 模块库。</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="$(RepositoryRoot)src\Runtime\Fast.Runtime.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SqlSugarCore" />
		<!-- 覆盖 SqlSugarCore 的传递依赖，固定到已修复安全问题的 2.1.x 原生 SQLite 包。 -->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
		<PackageReference Include="UAParser" />
		<PackageReference Include="Yitter.IdGenerator" />
	</ItemGroup>

</Project>
